    "test": "node --test tests/*.test.mjs server/*.test.mjs vscode-bridge/*.test.cjs",
    "test:ui": "node tests/ui.mjs && node tests/ui-organization.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0"
  }
