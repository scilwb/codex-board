{
  "name": "codex-board",
  "version": "0.1.0",
  "private": true,
  "description": "A local conversation map for Codex: organize projects and tasks, connect threads, and jump to VS Code.",
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "repository": { "type": "git", "url": "https://github.com/scilwb/codex-board.git" },
  "homepage": "https://scilwb.github.io/codex-board/",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
